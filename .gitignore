target/

# Real PSTs contain real mail. Nothing that came out of one belongs in this repo, and
# extensions alone are not enough of a guard: the bake-off once wrote files named
# "dist-list.pst__intact_", which every rule below except the directories missed.
tests/data/
tests/cases/
*.pst
*.ost
*.eml
*.msg
*.mbox

# Third-party material kept beside the repo for testing, never in it: the CMU Enron
# maildir tarball (and anything unpacked from it) and papers read along the way.
*.pdf
*.tar.gz
maildir/
